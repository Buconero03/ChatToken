{
  "manifest_version": 3,
  "name": "Context Guardian",
  "version": "1.3.0",
  "description": "Cross-browser BPE token counter for ChatGPT history, with a 240k historical token checkpoint alert.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "pagination.js",
        "alert-policy.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background.mjs"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Context Guardian — Token monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon32.png"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}
